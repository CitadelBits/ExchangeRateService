{
  "ExchangeRates": {
    "LogFilePath": "Logs/exchange-rates.log",
    "DateFormat": "dd.MM.yyyy, dddd",
    "DefaultProvider": "nbp",
    "CurrencySort": {
      "Field": "Code",
      "Direction": "Ascending"
    },
    "Providers": [
      {
        "Code": "nbp",
        "DisplayName": "Narodowy Bank Polski",
        "BaseUrl": "https://api.nbp.pl/",
        "TimeoutSeconds": 10,
        "Endpoints": {
          "Currencies": "api/exchangerates/tables/A?format=json",
          "Rates": "api/exchangerates/tables/A/{fromDate}/{toDate}?format=json"
        },
        "Settings": {
          "Format": "json"
        }
      },
      {
        "Code": "frankfurter",
        "DisplayName": "Frankfurter",
        "BaseUrl": "https://api.frankfurter.dev/",
        "TimeoutSeconds": 10,
        "Endpoints": {
          "Currencies": "v2/currencies",
          "Rates": "v2/rates?base={fromCurrency}&quotes={toCurrency}&from={fromDate}&to={toDate}"
        },
        "Settings": {
          "Format": "json"
        }
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "AllowedHosts": "*"
    
  }
}
