{
  "ExchangeRates": {
    "DateFormat": "yyyy-MM-dd",
    "DefaultProvider": "nbp",
    "CurrencySort": {
      "Field": "Code",
      "Direction": "Ascending"
    },
    "Providers": [
      {
        "Code": "nbp",
        "DisplayName": "Narodowy Bank Polski",
        "BaseUrl": "https://api.nbp.pl/",
        "TimeoutSeconds": 10,
        "Endpoints": {
          "Currencies": "api/exchangerates/tables/A/",
          "Rates": "api/exchangerates/tables/A/{startDate}/{endDate}/"
        },
        "Settings": {
          "Format": "json"
        }
      },
      {
        "Code": "frankfurter",
        "DisplayName": "Frankfurter",
        "BaseUrl": "https://api.frankfurter.dev/",
        "TimeoutSeconds": 10,
        "Endpoints": {
          "Currencies": "v2/currencies",
          "Rates": "v2/rates"
        },
        "Settings": {
          "Format": "json"
        }
      }
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
