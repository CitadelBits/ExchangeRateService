@page "/"
@using global::ExchangeRate.Blazor.WebServiceApi
@using global::ExchangeRate.Blazor.WebServiceApi.Dtos
@rendermode InteractiveServer

@if (!string.IsNullOrEmpty(errorMessage))
{
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <strong>Błąd!</strong> @errorMessage

    <button type="button"
            class="btn-close"
            aria-label="Zamknij"
            @onclick="() => errorMessage = null">
    </button>
  </div>
}


<div>
  <div class="container-fluid py-4">
    <div class="container-xxl">

      <!-- Header -->
      <header class="mb-4">
        <div class="d-flex align-items-center gap-3">
          <div class="bg-primary text-white rounded-3 p-3">
            <i class="bi bi-arrow-left-right fs-3"></i>
          </div>
          <div>
            <h1 class="h3 mb-1">Kursy walut</h1>
            <p class="text-body-secondary mb-0">
              Pobieraj i porównuj kursy walut z różnych źródeł
              oraz analizuj je w wybranym okresie.
            </p>
          </div>
        </div>
      </header>

      <!-- Query parameters -->
      <section class="card shadow-sm mb-4">
        <div class="card-body">
          <h2 class="h5 mb-3">Parametry zapytania</h2>

          <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-2">
              <label for="provider" class="form-label">
                Źródło danych
              </label>
              <select id="provider" 
                      class="form-select"
                      @bind=selectedProvider
                      @bind:after=OnProviderChanged>
                <option selected disabled>Wybierz źródło</option>
                @{
                  if (providersDto is not null)
                  {
                    foreach(var provider in providersDto.Providers)
                    {
                      <option value="@provider.Code">
                        @provider.Name
                      </option>
                    }
                  }
                } 
              </select>
            </div>

            <div class="col-12 col-md-6 col-lg-2">
              <label for="fromCurrency" class="form-label">
                Waluta źródłowa
              </label>
              <select id="fromCurrency" class="form-select" @bind=selectedCurrencyFrom>
                <option value="" selected disabled>Wybierz walutę</option>
                @{
                  if(currencies is not null)
                  {
                    foreach (var currency in currencies)
                    {
                      <option value="@currency.Code">
                        @currency.Code
                      </option>
                    }
                  }
                }
              </select>
            </div>

            <div class="col-12 col-md-6 col-lg-2">
              <label for="toCurrency" class="form-label">
                Waluta docelowa
              </label>
              <select id="toCurrency" class="form-select" @bind=selectedCurrencyTo>
                <option value="" selected disabled>Wybierz walutę</option>
                @{
                  if (currencies is not null)
                  {
                    foreach (var currency in currencies)
                    {
                      <option value="@currency.Code">
                        @currency.Code
                      </option>
                    }
                  }
                }
              </select>
            </div>

            <div class="col-12 col-md-6 col-lg-2">
              <label for="dateFrom" class="form-label">
                Okres od
              </label>
              <input id="dateFrom" type="date" class="form-control" @bind=selectedDateFrom>
            </div>

            <div class="col-12 col-md-6 col-lg-2">
              <label for="dateTo" class="form-label">
                Okres do
              </label>
              <input id="dateTo" type="date" class="form-control" @bind=selectedDateTo>
            </div>

            <div class="col-12 col-md-6 col-lg-2 d-grid">
              <button type="button" class="btn btn-primary"
              onclick="@OnGetCoursesClick">
                <i class="bi bi-search me-2"></i>
                Pobierz kursy
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- Statistics -->
      <section class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
              <div class="rounded-circle bg-success-subtle text-success p-3">
                <i class="bi bi-graph-up-arrow fs-4"></i>
              </div>
              <div>
                <div class="text-body-secondary">Minimum</div>
                <div class="h4 mb-0">@(exchangeRateStatisticsDto?.Min.ToString("F4") ?? "0,0000")</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
              <div class="rounded-circle bg-danger-subtle text-danger p-3">
                <i class="bi bi-graph-down-arrow fs-4"></i>
              </div>
              <div>
                <div class="text-body-secondary">Maksimum</div>
                <div class="h4 mb-0">@(exchangeRateStatisticsDto?.Max.ToString("F4") ?? "0,0000")</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
              <div class="rounded-circle bg-primary-subtle text-primary p-3">
                <i class="bi bi-bar-chart-line fs-4"></i>
              </div>
              <div>
                <div class="text-body-secondary">Średnia</div>
                <div class="h4 mb-0">@(exchangeRateStatisticsDto?.Avg.ToString("F4") ?? "0,0000")</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
          <div class="card shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
              <div class="rounded-circle bg-info-subtle text-info p-3">
                <i class="bi bi-list-ol fs-4"></i>
              </div>
              <div>
                <div class="text-body-secondary">Liczba notowań</div>
                <div class="h4 mb-0">@(exchangeRateStatisticsDto?.Observations.ToString() ?? "0")</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Courses history -->
      <section class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex flex-wrap justify-content-between
                                align-items-center gap-2 mb-3">
            <h2 class="h5 mb-0">Historia kursów</h2>
            <span class="text-body-secondary small">
              Wyniki dla wybranego okresu
            </span>
          </div>

          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col">Data</th>
                  <th scope="col">Kurs</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td colspan="4"
                      class="text-center text-body-secondary py-5">
                    <i class="bi bi-currency-exchange fs-2 d-block mb-2"></i>
                    Brak danych do wyświetlenia
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Fotter -->
      <footer class="text-body-secondary small text-center mt-4">
        Kursy walut · Dane pochodzą z wybranego dostawcy,
        np. NBP lub Frankfurter.
      </footer>

    </div>
  </div>
</div>




@code {
  ProvidersResponseDto providersDto = null;
  string selectedProvider = string.Empty;
  List<CurrencyDto> currencies;
  string selectedCurrencyFrom = string.Empty;
  string selectedCurrencyTo = string.Empty;
  DateOnly? selectedDateFrom;
  DateOnly? selectedDateTo;
  ExchangeRateStatisticsDto exchangeRateStatisticsDto;
  private string? errorMessage;

  private bool isLoading = true;
  protected override async Task OnInitializedAsync()
  {
    try
    {
      using var client = new ExchangeRateClient();
      providersDto = await client.GetProvidersAsync();
      selectedProvider = providersDto.DefaultProvider;
      await OnProviderChanged();
    }
    finally
    {
      isLoading = false;
    }
  }

  public async Task OnProviderChanged()
  {
    Console.WriteLine($"Selected provider: {selectedProvider}");

    selectedCurrencyFrom = string.Empty;
    selectedCurrencyTo = string.Empty;

    using var client = new ExchangeRateClient();
    currencies = await client.GetCurrenciesAsync(selectedProvider);
  }

  public async Task OnGetCoursesClick()
  {
    Console
    .WriteLine($"GetCourses clicked [Provider: {selectedProvider}], [Currency from: {selectedCurrencyFrom}], " + 
    $"[Currency to: {selectedCurrencyTo}], [Date from: {selectedDateFrom}], [Date to: {selectedDateTo}]");

    errorMessage = string.Empty;

    try{
      using var client = new ExchangeRateClient();
      exchangeRateStatisticsDto =
        await client.
        GetStatisticsAsync(
                selectedProvider, 
                selectedCurrencyFrom, 
                selectedCurrencyTo, 
                selectedDateFrom, 
                selectedDateTo);
    }
    catch(HttpRequestException ex)
    {
      errorMessage = ex.Message;
    }
    catch (Exception ex)
    {
      errorMessage = ex.Message;
    }
}

      }